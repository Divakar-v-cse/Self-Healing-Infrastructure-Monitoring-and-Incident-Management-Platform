# Copy to .env and adjust. NEVER commit the real .env file.

# --- runtime ---------------------------------------------------------------
SHIP_ENVIRONMENT=development
SHIP_LOG_LEVEL=INFO
SHIP_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- persistence -----------------------------------------------------------
# Local dev default (sqlite). Postgres works too:
# SHIP_DATABASE_URL=postgresql+psycopg://ship:change-me@postgres:5432/ship
SHIP_DATABASE_URL=sqlite:///./data/ship.db

# --- integrations ----------------------------------------------------------
SHIP_PROMETHEUS_URL=http://localhost:9090
SHIP_ALERTMANAGER_URL=http://localhost:9093
SHIP_SIMULATOR_URL=http://localhost:9101

# --- detection loop --------------------------------------------------------
SHIP_ENABLE_MONITOR_LOOP=true
SHIP_MONITOR_INTERVAL_SECONDS=30
SHIP_METRIC_RETENTION_DAYS=7

# --- recovery --------------------------------------------------------------
SHIP_RECOVERY_ENABLED=true
SHIP_ANSIBLE_ENABLED=true
# SAFETY DEFAULT: true. Ansible is NOT executed; actions are recorded as
# "simulated". Set to false only when the inventory points at reachable hosts.
SHIP_ANSIBLE_DRY_RUN=true
SHIP_ANSIBLE_BINARY=ansible-playbook
SHIP_ANSIBLE_TIMEOUT_SECONDS=300
# SHIP_ANSIBLE_PLAYBOOK_DIR=/srv/ansible/playbooks
# SHIP_ANSIBLE_INVENTORY=/srv/ansible/inventory/hosts.ini

# --- safeguards (loop prevention) -----------------------------------------
SHIP_MAX_ATTEMPTS_PER_INCIDENT=3
SHIP_MAX_ATTEMPTS_PER_WINDOW=5
SHIP_ATTEMPT_WINDOW_MINUTES=60
SHIP_RECOVERY_COOLDOWN_SECONDS=300
SHIP_CIRCUIT_BREAKER_THRESHOLD=3
SHIP_CIRCUIT_BREAKER_COOLDOWN_SECONDS=1800
SHIP_MAX_CONCURRENT_RECOVERIES=2
SHIP_INCIDENT_AUTORESOLVE_MINUTES=10

# --- grafana ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# Change this before exposing Grafana beyond localhost.
GRAFANA_ADMIN_PASSWORD=change-me-in-production
GRAFANA_ROOT_URL=http://localhost:3000

# --- optional: alert delivery ---------------------------------------------
# Wire a real receiver (Slack, PagerDuty, email) in
# monitoring/alertmanager/alertmanager.yml and keep credentials in a
# separate secret file referenced with `*_file`.
